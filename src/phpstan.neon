includes:
    - vendor/larastan/larastan/extension.neon
    # A Mockery mock is also the class it mocks (type extension only, no extra rules)
    - vendor/phpstan/phpstan-mockery/extension.neon
    # Narrows types after PHPUnit assertions, so assertions that can never fail are reported
    # (type extension only, not its rules.neon)
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    phpVersion: 80500
    paths:
        - app/
        - database/
        - tests/TestCase.php
        - tests/Support/
        - tests/Feature/
        - tests/Integration/
        - tests/Unit/
    level: 8
    ignoreErrors:
        - '#Trait .+ is used zero times and is not analysed#'
    excludePaths: []
