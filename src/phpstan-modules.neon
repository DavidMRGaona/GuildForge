# The core's PHPStan configuration applied to a module (scripts/check-module-quality.sh
# passes the module's src/, tests/ and database/ as the paths). The core's ignore patterns need not match there.
includes:
    - phpstan.neon

parameters:
    reportUnmatchedIgnoredErrors: false
    # Autoloads the modules' tests and database classes, which app/Modules/autoload.php leaves out
    bootstrapFiles:
        - phpstan-modules-bootstrap.php
