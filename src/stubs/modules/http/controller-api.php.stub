 * and module:make-request for {{ nameStudly }}.
 *
 * Route, in routes/api.php (answers under /api/{{ moduleName }}/{{ namePluralKebab }}):
 *
 *     Route::apiResource('{{ namePluralKebab }}', Api\{{ nameStudly }}Controller::class);
 */
final class {{ nameStudly }}Controller extends Controller
{
    public function __construct(
        private readonly {{ nameStudly }}ServiceInterface $service,
    ) {}

    public function index(): JsonResponse
    {
        $items = $this->service->all();

        return response()->json([
            'data' => array_map(fn ({{ nameStudly }}ResponseDTO $item): array => $item->toArray(), $items),
        ]);
    }

    public function store({{ nameStudly }}Request $request): JsonResponse
    {
        $dto = {{ nameStudly }}DTO::fromArray($request->validated());
        $item = $this->service->create($dto);

        return response()->json([
            'data' => $item->toArray(),
        ], 201);
