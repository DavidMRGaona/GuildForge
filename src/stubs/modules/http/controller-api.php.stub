        ]);
    }

    public function update({{ nameStudly }}Request $request, string $id): JsonResponse
    {
        $dto = {{ nameStudly }}DTO::fromArray($request->validated());
        $item = $this->service->update($id, $dto);

        return response()->json([
            'data' => $item->toArray(),
