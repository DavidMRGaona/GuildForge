<?php

declare(strict_types=1);

namespace {{ moduleNamespace }}\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

final class {{ nameStudly }}Request extends FormRequest
{
    public function authorize(): bool
    {
        // Returns true: authorize in the controller (Gate::authorize with the policy)
        // and protect the route with the auth middleware
        return true;
    }

    /**
     * @return array<string, array<int, string>>
     */
    public function rules(): array
    {
        return [
            'name' => ['required', 'string', 'max:255'],
        ];
    }
}
