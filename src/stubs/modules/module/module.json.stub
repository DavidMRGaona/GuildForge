{
    "name": "{{ moduleName }}",
    "displayName": "{{ moduleDisplayNameJson }}",
    "version": "0.0.0",{{ moduleRepositoryJson }}
    "namespace": "{{ moduleNamespaceJson }}",
    "provider": "{{ moduleNameStudly }}ServiceProvider",
    "description": "{{ moduleDescriptionJson }}",
    "author": "{{ moduleAuthorJson }}",
    "requires": {
        "core": "{{ coreConstraint }}",
        "php": ">=8.5",
        "laravel": ">=13.0",
        "filament": "^5.0"
    },
    "storesUtc": true,
    "dependencies": []
}
