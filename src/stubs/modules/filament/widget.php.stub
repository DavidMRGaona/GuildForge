<?php

declare(strict_types=1);

namespace {{ moduleNamespace }}\Filament\Widgets;

use Filament\Widgets\StatsOverviewWidget;
use Filament\Widgets\StatsOverviewWidget\Stat;

/**
 * Dashboard widget for {{ nameStudly }}.
 *
 * Add it to the dashboard by returning it from the module service provider:
 *
 *     public function registerFilamentWidgets(): array
 *     {
 *         return [{{ nameStudly }}Widget::class];
 *     }
 *
 * Admins can then toggle and order it on the dashboard settings page.
 */
final class {{ nameStudly }}Widget extends StatsOverviewWidget
{
    protected ?string $pollingInterval = null;

    protected static ?int $sort = 10;

    protected function getHeading(): string
    {
        return __('{{ moduleName }}::filament.widgets.{{ nameSnake }}.heading');
    }

    protected function getStats(): array
    {
        return [
            Stat::make(
                label: __('{{ moduleName }}::filament.widgets.{{ nameSnake }}.total'),
                value: $this->getTotalCount(),
            )
                ->description(__('{{ moduleName }}::filament.widgets.{{ nameSnake }}.total_description'))
                ->descriptionIcon('heroicon-m-arrow-trending-up')
                ->color('success'),

            Stat::make(
                label: __('{{ moduleName }}::filament.widgets.{{ nameSnake }}.pending'),
                value: $this->getPendingCount(),
            )
                ->description(__('{{ moduleName }}::filament.widgets.{{ nameSnake }}.pending_description'))
                ->descriptionIcon('heroicon-m-clock')
                ->color('warning'),

            Stat::make(
                label: __('{{ moduleName }}::filament.widgets.{{ nameSnake }}.active'),
                value: $this->getActiveCount(),
            )
                ->description(__('{{ moduleName }}::filament.widgets.{{ nameSnake }}.active_description'))
                ->descriptionIcon('heroicon-m-check-circle')
                ->color('info'),
        ];
    }

    private function getTotalCount(): int
    {
        // TODO: Replace with actual query
        // return MyModel::count();
        return 0;
    }

    private function getPendingCount(): int
    {
        // TODO: Replace with actual query
        // return MyModel::where('state', 'pending')->count();
        return 0;
    }

    private function getActiveCount(): int
    {
