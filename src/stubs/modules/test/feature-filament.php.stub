use {{ moduleNamespace }}\Filament\Resources\{{ nameStudly }}Resource\Pages\Edit{{ nameStudly }};
use {{ moduleNamespace }}\Infrastructure\Persistence\Eloquent\Models\{{ nameStudly }}Model;
use PHPUnit\Framework\Attributes\Test;
