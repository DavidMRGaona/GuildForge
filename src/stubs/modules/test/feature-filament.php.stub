use Tests\Support\Modules\ModuleTestCase;

final class {{ nameStudly }}ResourceTest extends ModuleTestCase
{
    use InteractsWithModulePanel;

    protected ?string $moduleName = '{{ moduleName }}';

    protected bool $autoEnableModule = true;

    protected function setUp(): void
    {
        parent::setUp();

        $this->registerOnAdminPanel([{{ nameStudly }}Resource::class]);
        $this->actingAsPanelAdmin();
    }

    #[Test]
    public function it_lists_{{ namePluralSnake }}(): void
    {
        $this->get({{ nameStudly }}Resource::getUrl('index'))->assertSuccessful();
    }

    #[Test]
    public function it_creates_a_{{ nameSnake }}(): void
    {
        Livewire::test(Create{{ nameStudly }}::class)
            ->fillForm(['name' => 'Nombre de prueba'])
            ->call('create')
