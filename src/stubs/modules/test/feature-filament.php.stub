        $this->assertDatabaseHas('{{ tableName }}', ['name' => 'Nombre de prueba']);
    }

    #[Test]
    public function it_edits_a_{{ nameSnake }}(): void
    {
        $record = {{ nameStudly }}Model::create(['name' => 'Nombre original']);

        Livewire::test(Edit{{ nameStudly }}::class, ['record' => $record->getRouteKey()])
            ->fillForm(['name' => 'Nombre cambiado'])
            ->call('save')
            ->assertHasNoFormErrors();

        $this->assertDatabaseHas('{{ tableName }}', ['id' => $record->id, 'name' => 'Nombre cambiado']);
    }
