<?php

declare(strict_types=1);

namespace {{ moduleNamespace }}\Tests\Feature\Http\Controllers;

use Inertia\Testing\AssertableInertia as Assert;
use PHPUnit\Framework\Attributes\Test;
use Tests\Support\Modules\ModuleTestCase;

/**
 * Expects the route module:make-controller prints, in routes/web.php:
 *
 *     Route::get('{{ namePluralKebab }}', [{{ nameStudly }}Controller::class, 'index'])->name('{{ namePluralSnake }}.index');
 */
final class {{ nameStudly }}ControllerTest extends ModuleTestCase
{
    protected ?string $moduleName = '{{ moduleName }}';

    protected bool $autoEnableModule = true;

    #[Test]
    public function it_renders_the_{{ nameSnake }}_page(): void
    {
        $this->get(route('{{ moduleNameSnake }}.{{ namePluralSnake }}.index'))
            ->assertOk()
            ->assertInertia(fn (Assert $page) => $page->component('{{ moduleNameStudly }}/{{ nameStudly }}', false));
    }
}
