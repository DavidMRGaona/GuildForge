{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "guildforge",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint resources/js --ext .ts,.vue",
        "lint:fix": "eslint resources/js --ext .ts,.vue --fix",
        "format": "prettier --write resources/js/**/*.{ts,vue}",
        "format:check": "prettier --check resources/js/**/*.{ts,vue}",
        "verify:build": "node scripts/verify-build.mjs"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.20",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/interaction": "^6.1.20",
        "@fullcalendar/luxon3": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.20",
        "@fullcalendar/vue3": "^6.1.20",
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.9.1",
        "@lucide/vue": "^1.56.0",
        "@unhead/vue": "^3.4.3",
        "@vue-leaflet/vue-leaflet": "^0.10.1",
        "@vue/devtools-api": "^8.2.1",
        "leaflet": "^1.9.4",
        "luxon": "^3.7.2",
        "pinia": "^4.0.3",
        "vue": "^3.5.26",
        "vue-i18n": "^11.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.0",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^24.19.1",
        "@typescript-eslint/eslint-plugin": "^8.53.0",
        "@typescript-eslint/parser": "^8.53.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.7.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.8.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vue-tsc": "^3.2.2"
    }
}
