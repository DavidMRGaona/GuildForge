{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "guildforge",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
        "test:unit": "vitest run",
        "lint": "eslint resources/js scripts *.config.ts --ext .ts,.vue,.mjs",
        "lint:fix": "eslint resources/js scripts *.config.ts --ext .ts,.vue,.mjs --fix",
        "format": "prettier --write \"resources/js/**/*.{ts,vue}\" \"scripts/**/*.{mjs,ts,vue}\" \"*.config.ts\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,vue}\" \"scripts/**/*.{mjs,ts,vue}\" \"*.config.ts\"",
        "verify:build": "node scripts/verify-build.mjs",
        "build:module": "sh scripts/build-module.sh",
        "public-api:report": "node scripts/public-api-report.mjs --write",
        "check:public-api": "node scripts/public-api-report.mjs"
    },
    "dependencies": {
        "@fullcalendar/vue3": "^7.1.3",
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.9.1",
        "@lucide/vue": "^1.56.0",
        "@unhead/vue": "^3.4.3",
        "@vue-leaflet/vue-leaflet": "^0.10.1",
        "@vue/devtools-api": "^8.2.1",
        "leaflet": "^1.9.4",
        "pinia": "^4.0.3",
        "temporal-polyfill": "^1.0.6",
        "vue": "^3.5.26",
        "vue-i18n": "^11.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.0",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^24.19.1",
        "@typescript-eslint/eslint-plugin": "^8.53.0",
        "@typescript-eslint/parser": "^8.53.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.7.0",
        "happy-dom": "^20.14.6",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.8.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.2.2"
    }
}
