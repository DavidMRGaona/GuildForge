APP_NAME="GuildForge"
APP_DESCRIPTION="Platform for wargames and role-playing games guilds"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# The storage zone now comes from the storage_timezone marker in the database (default: APP_STORAGE_TIMEZONE_DEFAULT); people see APP_DISPLAY_TIMEZONE
APP_TIMEZONE=Europe/Madrid
# Zone people see and the scheduler uses
APP_DISPLAY_TIMEZONE=Europe/Madrid
# Storage zone while the database has no storage_timezone marker (Europe/Madrid or UTC): fresh installs start in UTC
APP_STORAGE_TIMEZONE_DEFAULT=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_CHANNELS=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Elasticsearch Logging (dev: false unless testing ES, prod: true)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=guildforge-logs
ELASTICSEARCH_SSL=false

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=guildforge
DB_USERNAME=guildforge
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set to true for HTTPS-only cookies
SESSION_SECURE_COOKIE=false

# Trusted proxies: use specific IPs in production (e.g., 192.168.1.0/24)
# Default '*' trusts all proxies, suitable only for Docker development
TRUSTED_PROXIES=*

# Real time (optional, core#493): leave "log" or "null" to keep it off; the pages poll instead.
# To turn it on, set "reverb", fill the REVERB_* settings and run `php artisan reverb:start`
# (see docs/realtime.md).
BROADCAST_CONNECTION=log
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# Where the application publishes (the Reverb process)
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# Where the Reverb process listens
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# Where browsers connect; by default the site's own address (APP_URL)
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=
# REVERB_PUBLIC_SCHEME=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Knowledge base search: "meilisearch" or "null" (searches in PHP, no external service)
SCOUT_DRIVER=null
# Index prefix: each tenant sharing a Meilisearch must use a different one (e.g. site1_)
SCOUT_PREFIX=
# Local Docker: http://meilisearch:7700 with the dev master key from docker-compose.yml
MEILISEARCH_HOST=
MEILISEARCH_KEY=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=guildforge_
# Cache database: each tenant sharing a Redis must use a different value (e.g. 1 and 2)
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_PREFIX=guildforge
VITE_CLOUDINARY_PREFIX="${CLOUDINARY_PREFIX}"
# Lets the panel media library delete unused files; keep false on copies sharing a real site's account and prefix
MEDIA_LIBRARY_DELETE_ENABLED=false

# Image Optimization
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_OPTIMIZATION_MAX_WIDTH=2048
IMAGE_OPTIMIZATION_MAX_HEIGHT=2048
IMAGE_OPTIMIZATION_QUALITY=85
IMAGE_OPTIMIZATION_FORMAT= # null = keep original format

# Bot protection
BOT_PROTECTION_ENABLED=true
BOT_LOG_BLOCKED=false

MODULES_PATH=modules
