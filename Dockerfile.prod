# syntax=docker/dockerfile:1
# ↑ Enables BuildKit features (cache mounts, parallel builds)

# Stage 0a: PHP dependencies, shared by the asset build (Filament's CSS for the panel
# theme) and the final image. Installed without extensions: the final stage checks
# the platform against the real PHP build (composer check-platform-reqs)
FROM composer:2.10 AS vendor
WORKDIR /app
COPY src/composer.json src/composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    composer install --no-dev --no-scripts --no-autoloader --no-interaction \
        --prefer-dist --ignore-platform-reqs
# Only the CSS the panel theme imports (resources/css and the prebuilt dist/*.css),
# so Filament releases that change no CSS keep the cached asset build
RUN mkdir -p /filament-css \
    && cd vendor/filament \
    && find . -name '*.css' \( -path './*/resources/css/*' -o -path './*/dist/*' \) \
        | tar -cf - -T - | tar -xf - -C /filament-css

# Stage 0b: only the files the frontend build reads. BuildKit caches COPY --from by
# content, so commits that only touch PHP reuse the cached asset build below.
# app/Filament stays for the panel theme's @source: a change there rebuilds assets
FROM alpine:3.22 AS frontend-sources
WORKDIR /src
COPY src/ .
RUN find . -mindepth 1 -maxdepth 1 \
        ! -name app ! -name resources ! -name modules ! -name scripts \
        ! -name package.json ! -name package-lock.json \
        ! -name vite.config.ts ! -name tsconfig.json ! -name tsconfig.node.json \
        -exec rm -rf {} + \
    && find app -mindepth 1 -maxdepth 1 ! -name Filament -exec rm -rf {} + \
    && find scripts -mindepth 1 -maxdepth 1 ! -name verify-build.mjs ! -name public-api.mjs -exec rm -rf {} +

# Stage 1: Build frontend assets
FROM node:24-alpine AS assets
WORKDIR /build
COPY src/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci
COPY --from=frontend-sources /src/ .
COPY --from=vendor /filament-css/ vendor/filament/
# vite build only: types are checked by CI, which every deployment waits for. The check
# fails if the core build took in the modules below: production builds carry none, and
# their pages, slot components and translations must load from each module's build here too
RUN npx vite build && node scripts/verify-build.mjs

# Build module assets (modules with package.json and vite.config.ts). Every module repo
# tracks its lockfile, so npm ci; a module that fails to install or build fails the
# image. Coolify builds carry no modules (src/modules is not in the host repo), so this
# loop only does work in prod-local builds.
RUN --mount=type=cache,target=/root/.npm \
    for dir in modules/*/; do \
        if [ -f "$dir/package.json" ] && [ -f "$dir/vite.config.ts" ]; then \
            echo "Building module: $dir"; \
            (cd "/build/$dir" && npm ci && npm run build) \
                || { echo "Module build failed: $dir" >&2; exit 1; }; \
        fi; \
    done

# Consolidate module build artifacts for easy COPY to stage 2
RUN mkdir -p /module-builds && \
    for dir in modules/*/; do \
        module_name=$(basename "$dir"); \
        if [ -d "$dir/public/build" ]; then \
            mkdir -p "/module-builds/$module_name/public" && \
            cp -a "$dir/public/build" "/module-builds/$module_name/public/build"; \
        fi; \
    done

# Stage 2: Production image
# Pinned to the patch release: a floating tag can reuse an older base cached on
# the build host
FROM php:8.5.12-fpm-alpine3.24 AS final

# Install system dependencies (runtime)
RUN apk add --no-cache \
    nginx \
    supervisor \
    libpq \
    libpng \
    libjpeg-turbo \
    libwebp \
    freetype \
    libzip \
    icu-libs \
    oniguruma \
    imagemagick

# Install PHP extensions (cached layer - rarely changes)
RUN --mount=type=cache,target=/var/cache/apk \
    apk add --virtual .build-deps \
        $PHPIZE_DEPS \
        postgresql-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        libwebp-dev \
        freetype-dev \
        libzip-dev \
        icu-dev \
        oniguruma-dev \
        imagemagick-dev \
    && docker-php-source extract \
    # redis and imagick come from their release tags on GitHub, checked by hash:
    # pecl.php.net is a single point of failure for every build
    && mkdir -p /usr/src/php/ext/redis /usr/src/php/ext/imagick \
    && curl -fsSL -o /tmp/redis.tar.gz https://github.com/phpredis/phpredis/archive/refs/tags/6.3.0.tar.gz \
    && curl -fsSL -o /tmp/imagick.tar.gz https://github.com/Imagick/imagick/archive/refs/tags/3.8.1.tar.gz \
    && echo "cb8f81df1a275599e4f8ddcfec7e1f65ed1953e6f5673649149fd680ebff4cad  /tmp/redis.tar.gz" | sha256sum -c - \
    && echo "b0e9279ddf6e75a8c6b4068e16daec0475427dbca7ce2e144e30a51a88aa5ddc  /tmp/imagick.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/redis.tar.gz -C /usr/src/php/ext/redis --strip-components=1 \
    && tar -xzf /tmp/imagick.tar.gz -C /usr/src/php/ext/imagick --strip-components=1 \
    # Only PECL packaging fills in the imagick version; the tag leaves a placeholder
    && sed -i 's/@PACKAGE_VERSION@/3.8.1/' /usr/src/php/ext/imagick/php_imagick.h \
    && rm /tmp/redis.tar.gz /tmp/imagick.tar.gz \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
    && docker-php-ext-install -j$(nproc) \
        pdo_pgsql \
        pgsql \
        gd \
        zip \
        bcmath \
        intl \
        mbstring \
        exif \
        pcntl \
        redis \
        imagick \
    && docker-php-source delete \
    && apk del .build-deps

# OPcache is compiled into PHP 8.5: it is not installed above and must not be loaded
# with zend_extension. Fail the build if the CLI or the FPM binary comes without it
RUN php -m | grep -qx 'Zend OPcache' \
    && php-fpm -m | grep -qx 'Zend OPcache'

# Install Composer
COPY --from=composer:2.10 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# PHP dependencies from the vendor stage (cached while composer.* are unchanged).
# That stage skipped the platform check: run it here against this PHP build
COPY src/composer.json src/composer.lock ./
COPY --from=vendor /app/vendor vendor
RUN composer check-platform-reqs --no-dev

# Copy PHP source code
COPY src/ .

# Clear cached configs and regenerate autoloader with all files
RUN rm -f bootstrap/cache/*.php \
    && rm -rf storage/framework/views/* \
    && composer dump-autoload --optimize \
    && php artisan package:discover --ansi

# Remove dev-mode hot file (if it slipped through .dockerignore)
RUN rm -f public/hot

# Copy built assets from stage 1 (main app)
COPY --from=assets /build/public/build public/build

# Inject pre-built module assets from stage 1 into module directories
COPY --from=assets /module-builds/ /tmp/module-builds/
RUN for dir in /tmp/module-builds/*/; do \
        module_name=$(basename "$dir"); \
        if [ -d "$dir/public/build" ] && [ -d "modules/$module_name" ]; then \
            mkdir -p "modules/$module_name/public" && \
            cp -a "$dir/public/build" "modules/$module_name/public/"; \
        fi; \
    done && rm -rf /tmp/module-builds

# Backup modules to non-volume path (volume will mask /var/www/html/modules)
RUN cp -a modules /opt/modules-image

# Create directories and set permissions
RUN mkdir -p storage/framework/{cache,sessions,views} storage/logs modules bootstrap/cache \
    && chmod -R 775 storage modules bootstrap/cache \
    && chown -R www-data:www-data storage modules bootstrap/cache public/build

# Copy production configs
COPY docker/prod/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/prod/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/prod/php.ini /usr/local/etc/php/conf.d/production.ini
COPY docker/prod/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
